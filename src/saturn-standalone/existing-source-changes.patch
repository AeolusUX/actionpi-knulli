+bool InputManager::parseEvent(const SDL_Event& ev)
+{
+  // ACTIONPI_L3_MENU: toggle on release, using the ES device mapping.
+  if (ev.type == SDL_JOYBUTTONUP) {
+    auto found = mInputConfigs.find(ev.jbutton.which);
+    if (found != mInputConfigs.end() && found->second != nullptr) {
+      Input binding;
+      bool mapped = found->second->getInputByName("l3", &binding);
+      if (!mapped) mapped = found->second->getInputByName("leftthumb", &binding);
+      if (mapped && binding.type == TYPE_BUTTON && binding.id == ev.jbutton.button) {
+        SDL_Event toggle = {};
+        toggle.type = showmenu_;
+        SDL_PushEvent(&toggle);
+        return true;
+      }
+    }
+  }
+  if( this->menu_layer_) {
+    return parseEventMenu(ev);
+  }
+  bool causedEvent = false;
+  switch(ev.type)
+  {
+  case SDL_JOYBUTTONUP:{
+/*
+    for( int i=0; i<menu_inputs_.size(); i++  ){
+         if( ev.jbutton.button == menu_inputs_[i].select_button_ && 
+             ev.jbutton.which == menu_inputs_[i].select_device_ ){
+        SDL_Event event = {};
+        event.type = showmenu_;
+        event.user.code = 0;
+        event.user.data1 = 0;
+        event.user.data2 = 0;
+        SDL_PushEvent(&event);
+        return true;
+      }   
+    }
+*/
+    return true;
+  }    
+  case SDL_KEYDOWN:
+    if(ev.key.repeat)
+      return false;
+    if(ev.key.keysym.sym == SDLK_ESCAPE)
+    {
+      SDL_Event event = {};
+      event.type = showmenu_;
+      event.user.code = 0;
+      event.user.data1 = 0;
+      event.user.data2 = 0;
+      SDL_PushEvent(&event);
+      return false;
+    }
+    PerKeyDown( ev.key.keysym.sym | KEYBOARD_MASK );
+    //printf("PerKeyDown %d\n", ev.key.keysym.sym);
+    return true;
+  case SDL_KEYUP:
+     PerKeyUp( ev.key.keysym.sym | KEYBOARD_MASK );
+    return true;
+  case SDL_JOYDEVICEADDED:
+    updateConfig();
+    addJoystickByDeviceIndex(ev.jdevice.which); // ev.jdevice.which is a device index
+    return true;
+  case SDL_JOYDEVICEREMOVED:
+    updateConfig();  
+    removeJoystickByJoystickID(ev.jdevice.which); // ev.jdevice.which is an SDL_JoystickID (instance ID)
+    return false;
+  }
+  return false;
+}
