+
+static u32 mmapsize = 0;
+
+void * YabMemMap(char * filename, u32 size ) {
+
+  struct stat sb;
+  off_t len;
+  char *p;
+  int fd;
+
+  fd = open(filename, O_RDWR);
+  if (fd ==-1) {
+    LOG("YabMemMap: open failed");
+    return NULL;
+   }
+
+  if (fstat(fd, &sb) ==-1) {
+    LOG("YabMemMap: fstat failed");
+    close(fd);
+    return NULL;
+  }
+
+  if (sb.st_size > 10 * 1024 * 1024) {
+    LOG("YabMemMap: file too large (%lld bytes), refusing to mmap", (long long)sb.st_size);
+    close(fd);
+    return NULL;
+  }
+
+  p = mmap(0, sb.st_size, PROT_READ| PROT_WRITE, MAP_SHARED, fd, 0);
+  if (p == MAP_FAILED) {
+    LOG("YabMemMap: mmap failed");
+    return NULL;
+  }
+
+  if (close(fd) == -1) {
+    LOG("YabMemMap: close failed");
+    return NULL;
+  }
+
+  mmapsize = sb.st_size;
+  return p;
+}
+
+void YabFreeMap(void * p) {
+  munmap(p, mmapsize);
+}
+
+int YabFlushMemMap(void* mappedPtr)
+{
+  if (mappedPtr == NULL || mmapsize == 0) {
+    return -1;  // 何もすることがない
+  }
+
+  // MS_SYNC: 呼び出しが戻るときには、少なくともカーネルバッファまでは書き出されている
+  if (msync(mappedPtr, mmapsize, MS_SYNC) != 0) {
+    //LOG("YabFlushMemMap: msync failed: %s", strerror(errno));
+    return -1;
+  }
+
+  return 0;
+}
