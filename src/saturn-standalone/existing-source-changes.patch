-int YabLoadState(const char *filename)
-{
-   FILE *fp;
-   int status;
-
-   filename = MakeMovieStateName(filename);
-   if (!filename)
-      return -1;
-
-   if ((fp = fopen_utf8(filename, "rb")) == NULL)
-      return -1;
-
-   ScspLockThread();
-   status = YabLoadStateStream(fp);
-   ScspUnLockThread();
-
-   fclose(fp);
-
-   return status;
-}
