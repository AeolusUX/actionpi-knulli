-    }
-#endif
-  for(i = 0; i < 256; i++)
-    scsp_tl_table[i] = scsp_round(pow(10, ((double)i * -0.3762) / 20) * 1024.0);
-
-  scsp_reset();
-  thread_running = 0;
-  //YabAddEventQueue(q_scsp_frame_start, 0);
