+void
+ScspConvert32uto16s (s32 *srcL, s32 *srcR, s16 *dst, u32 len)
+{
+  u32 i;
+
+  for (i = 0; i < len; i++)
+    {
+      // Left Channel
+      if (*srcL > 0x7FFF)
+        *dst = 0x7FFF;
+      else if (*srcL < -0x8000)
+        *dst = -0x8000;
+      else
+        *dst = *srcL;
+
+      srcL++;
+      dst++;
+
+      // Right Channel
+      if (*srcR > 0x7FFF)
+        *dst = 0x7FFF;
+      else if (*srcR < -0x8000)
+        *dst = -0x8000;
+      else
+        *dst = *srcR;
+
+      srcR++;
+      dst++;
+    }
+}
