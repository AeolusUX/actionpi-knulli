+int OSDNanovgInit(void)
+{
+  /* Init runs before the renderer owns the GL context. GPU resources are
+     created by the first display call on the actual render thread. */
+  vg = NULL;
+  fps_init_attempted = 0;
+  return 0;
+}
+
+static int OSDNanovgCreateOnRenderThread(void)
+{
+#if defined(__RETORO_ARENA__)
+  // The menu is created lazily. FPS owns a GLES context independent of it.
+#if defined(_OGLES3_)
+  vg = nvgCreateGLES3(NVG_ANTIALIAS);
+#else
+  vg = nvgCreateGL3(NVG_ANTIALIAS);
+#endif
+#else
+#if defined(_OGLES3_)
+  vg = nvgCreateGLES3(NVG_ANTIALIAS);
+#else
+  vg = nvgCreateGL3(NVG_ANTIALIAS);
+#endif
+#endif  
+  if (vg == NULL) {
+    printf("Could not init nanovg.\n");
+    return -1;
+  }
+
+#if defined(ANDROID)
+  fontNormal = nvgCreateFontMem(vg, "sans", Roboto_Regular_ttf, Roboto_Regular_ttf_len, 0);
+  if (fontNormal == -1) {
+    printf("Could not add font italic.\n");
+    return -1;
+  }
+  fontBold = nvgCreateFontMem(vg, "sans", Roboto_Bold_ttf, Roboto_Bold_ttf_len, 0);
+  if (fontBold == -1) {
+    printf("Could not add font bold.\n");
+    return -1;
+  }
+#else
+  fontNormal = nvgCreateFont(vg, "sans", "./fonts/NotoSansJP-Medium.ttf" );
+  if (fontNormal == -1) {
+    printf("Could not add font italic.\n");
+    fontNormal = nvgCreateFontMem(vg, "sans", Roboto_Regular_ttf, Roboto_Regular_ttf_len, 0);
+    if (fontNormal == -1) {
+      printf("Could not add font italic.\n");
+      return -1;
+    }
+  }
+  fontBold = nvgCreateFont(vg, "sans-bold", "./fonts/NotoSansJP-Bold.ttf");
+  if (fontBold == -1) {
+    printf("Could not add font bold.\n");
+    fontBold = nvgCreateFontMem(vg, "sans", Roboto_Bold_ttf, Roboto_Bold_ttf_len, 0);
+    if (fontBold == -1) {
+      printf("Could not add font bold.\n");
+      return -1;
+    }    
+  }
+#endif
+
+  memset(frameinfo_histroy, 0, sizeof(FrameProfileInfo)*MAX_HISTORY);
+  current_history_index = 0;
+  profile_index = 0;
+
+  return 0;
+}
