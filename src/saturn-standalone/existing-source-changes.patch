+   // Fill the rest
+   FillMemoryArea(0x000, 0x00F, &BiosRomMemoryReadByte,
+                                &BiosRomMemoryReadWord,
+                                &BiosRomMemoryReadLong,
+                                &BiosRomMemoryWriteByte,
+                                &BiosRomMemoryWriteWord,
+                                &BiosRomMemoryWriteLong);
+   FillMemoryArea(0x010, 0x017, &SmpcReadByte,
+                                &SmpcReadWord,
+                                &SmpcReadLong,
+                                &SmpcWriteByte,
+                                &SmpcWriteWord,
