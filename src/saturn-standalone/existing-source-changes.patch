+void
+M68KClearCodeBreakpoints ()
+{
+  int i;
+  for (i = 0; i < MAX_BREAKPOINTS; i++)
+    ScspInternalVars->codebreakpoint[i].addr = 0xFFFFFFFF;
+
+  ScspInternalVars->numcodebreakpoints = 0;
+}
