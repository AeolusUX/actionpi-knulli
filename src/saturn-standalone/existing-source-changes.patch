+void fill_plfo_tables()
+{
+   int i;
+
+   //saw
+   for (i = 0; i < 256; i++)
+   {
+      if (i < 128)
+         plfo.saw_table[i] = i;
+      else
+         plfo.saw_table[i] = -256 + i;
+   }
+
+   //square
+   for (i = 0; i < 256; i++)
+   {
+      if (i < 128)
+         plfo.square_table[i] = 127;
+      else
+         plfo.square_table[i] = -128;
+   }
+
+   //triangular
+   for (i = 0; i < 256; i++)
+   {
+      if (i < 64)
+         plfo.tri_table[i] = i * 2;
+      else if (i < 192)
+         plfo.tri_table[i] = 255 - (i * 2);
+      else
+         plfo.tri_table[i] = (i * 2) - 512;
+   }
+
+   //noise
+   for (i = 0; i < 256; i++)
+   {
+      plfo.noise_table[i] = rand() & 0xff;
+   }
+}
