+      joystics["-1_Keyboard_-1"]["start"] ={ { "type", "key" },{ "id", SDLK_RETURN },{ "value", 0 } };
+      joystics["-1_Keyboard_-1"]["select"] ={ { "type", "key" },{ "id", SDLK_ESCAPE },{ "value", 0 } };
+      joystics["-1_Keyboard_-1"]["up"] ={ { "type", "key" },{ "id", SDLK_UP },{ "value", 0 } };
