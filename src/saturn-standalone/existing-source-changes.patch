+int YabSaveStateBuffer(void ** buffer, size_t * size)
+{
+   FILE * fp;
+   int status;
+   size_t num_read = 0;
+
+   if (buffer != NULL) *buffer = NULL;
+   *size = 0;
+
+   fp = tmpfile();
+
+   ScspLockThread();
+   status = YabSaveStateStream(fp);
+   ScspUnLockThread();
+
+   if (status != 0)
+   {
+      fclose(fp);
+      return status;
+   }
+
+   fseek(fp, 0, SEEK_END);
+   *size = ftell(fp);
+   fseek(fp, 0, SEEK_SET);
+
+   if (buffer != NULL)
+   {
+      *buffer = malloc(*size);
+      num_read = fread(*buffer, 1, *size, fp);
+   }
+
+   fclose(fp);
+   return 0;
+}
