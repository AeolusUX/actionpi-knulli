+  if (addr > 0x7FFFF)
+    return;
+
+  //LOG("SoundRamWriteLong %08X:%08X", addr, val);
+  if (!Sh2SramStageWrite(addr, val, 4)) {
+    T2WriteLong (SoundRam, addr, val);
+    M68K->WriteNotify (addr, 4);
+  }
+  //SyncSh2And68k();
+
+}
