-      for (u = 3; u < width*height * 4; u += 4) {
-        buf[u] = 0xFF;
-      }
-    }
-
-
-    row_pointers = (png_byte**)malloc(sizeof(png_bytep) * height);
-    for (v=0; v<height; v++)
-        row_pointers[v] = (png_byte*)&buf[ (height-1-v) * width * 4];
-
-    // save as png
