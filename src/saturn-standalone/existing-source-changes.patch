-        YUI_LOG("can't open %s\n", filename);
-        goto FINISH;
-    }
-
-    /* initialize stuff */
-    png_ptr = png_create_write_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL);
-
-    if (!png_ptr){
-        YUI_LOG("[write_png_file] png_create_write_struct failed");
-        goto FINISH;
-    }
-
-    info_ptr = png_create_info_struct(png_ptr);
