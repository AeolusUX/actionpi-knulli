+void narrow(const std::wstring &src, std::string &dest) {
+  setlocale(LC_ALL, "ja_JP.UTF-8");
+  char *mbs = new char[src.length() * MB_CUR_MAX + 1];
+  wcstombs(mbs, src.c_str(), src.length() * MB_CUR_MAX + 1);
+  dest = mbs;
+  delete[] mbs;
+}
