-    LOG("revoke thread\n");
-#if defined(_JETSON_) || defined(PC) || defined(_WINDOWS)
-    if (g_vidcoretype == VIDCORE_VULKAN)
-    {
-      return 0;
-    }
-
-    int rc = -1;
-    int retry = 0;
-    while (rc != 0) {
-      YabThreadUSleep(16666);
-      retry++;
-      rc = SDL_GL_MakeCurrent(subwnd, subglc);
-      if (rc != 0) { LOG("fail revoke thread\n"); }
-      if (retry > 100) {
-        LOG("out of retry cont\n");
-        abort();
