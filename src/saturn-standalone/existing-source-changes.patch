-      else
-         plfo.square_table[i] = -128;
-   }
-
-   //triangular
-   for (i = 0; i < 256; i++)
-   {
-      if (i < 64)
-         plfo.tri_table[i] = i * 2;
-      else if (i < 192)
-         plfo.tri_table[i] = 255 - (i * 2);
-      else
-         plfo.tri_table[i] = (i * 2) - 512;
-   }
-
-   //noise
-   for (i = 0; i < 256; i++)
