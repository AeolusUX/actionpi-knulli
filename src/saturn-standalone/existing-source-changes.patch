-      scsp_attack_rate[i] = scsp_attack_rate[63];
-      scsp_decay_rate[i] = scsp_decay_rate[63];
-      scsp_null_rate[i - 64] = 0;
-    }
-#if 0
-  for(i = 0; i < 96; i++)
-    {
