+int
+ScspChangeVideoFormat (int type)
+{
+  scspsoundlen = 44100 / (type ? 50 : 60);
+  scsplines = type ? 313 : 263;
+  scspsoundbufsize = scspsoundlen * scspsoundbufs;
+
+  if (scsp_alloc_bufs () < 0)
+    return -1;
+
+  SNDCore->ChangeVideoFormat (type ? 50 : 60);
+
+  return 0;
+}
