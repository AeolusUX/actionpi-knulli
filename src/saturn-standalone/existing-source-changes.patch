+static u8 header[32] = {
+  0xFF, 'B', 0xFF, 'a', 0xFF, 'c', 0xFF, 'k',
+  0xFF, 'U', 0xFF, 'p', 0xFF, 'R', 0xFF, 'a',
+  0xFF, 'm', 0xFF, ' ', 0xFF, 'F', 0xFF, 'o',
+  0xFF, 'r', 0xFF, 'm', 0xFF, 'a', 0xFF, 't'
+};
+
+int CheckBackupFile(FILE *fp) {
+  int i, i2;
+  u32 i3;
+
+  // Fill in header
+  for (i2 = 0; i2 < 4; i2++) {
+    for (i = 0; i < 32; i++) {
+      u8 val = fgetc(fp);
+      if ( val != header[i]) {
+        return -1;
+      }
+    }
+  }
+  return 0;
+}
+
+int ExtendBackupFile(FILE *fp, u32 size ) {
+
+  fseek(fp, 0, SEEK_END);
+  u32 acsize = ftell(fp);
+  if (acsize < size) {
+    // Clear the rest
+    u32 i;
+    for ( i = (acsize&0xFFFFFFFE) ; i < size; i += 2)
+    {
+      fputc(0xFF, fp);
+      fputc(0x00, fp);
+    }
+    fflush(fp);
+  }
+  fseek(fp, 0, SEEK_SET);
+
+  return 0;
+}
+
+
+//////////////////////////////////////////////////////////////////////////////
+void FormatBackupRamFile(FILE *fp, u32 size) {
+
+  int i, i2;
+  u32 i3;
+
+  fseek(fp, 0, SEEK_SET);
+
+  // Fill in header
+  for (i2 = 0; i2 < 4; i2++)
+    for (i = 0; i < 32; i++)
+      fputc(header[i],fp);
+
+  // Clear the rest
+  for (i3 = 0x80; i3 < size; i3 += 2)
+  {
+    fputc(0xFF,fp);
+    fputc(0x00,fp);
+  }
+  fflush(fp);
+
+  // Truncate any excess data beyond the expected size
+#if defined(_WIN32) || defined(_WINDOWS)
+  _chsize(_fileno(fp), size);
+#else
+  ftruncate(fileno(fp), size);
+#endif
+}
+
+void FormatBackupRam(void *mem, u32 size)
+{
+   int i, i2;
+   u32 i3;
+
+   // Fill in header
+   for(i2 = 0; i2 < 4; i2++)
+      for(i = 0; i < 32; i++)
+         T1WriteByte(mem, (i2 * 32) + i, header[i]);
+
+   // Clear the rest
+   for(i3 = 0x80; i3 < size; i3+=2)
+   {
+      T1WriteByte(mem, i3, 0xFF);
+      T1WriteByte(mem, i3+1, 0x00);
+   }
+}
