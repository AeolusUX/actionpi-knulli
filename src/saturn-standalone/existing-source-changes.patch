-s16 apply_volume(u16 tl, u16 slot_att, const s16 s)
-{
-   s32 sample_att = 0;
-   s32 v = 0;
-
-   v += tl * 4;
-   v += slot_att;
-   if (v > 0x3ff)
-     v = 0x3ff;
-
-   sample_att = (s * ((v & 0x3F) ^ 0x7F)) >> ((v >> 6) + 7);
-
-   return sample_att;
-}
