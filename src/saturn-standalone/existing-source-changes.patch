-int ExtendBackupFile(FILE *fp, u32 size ) {
-
-  fseek(fp, 0, SEEK_END);
-  u32 acsize = ftell(fp);
-  if (acsize < size) {
-    // Clear the rest
-    u32 i;
-    for ( i = (acsize&0xFFFFFFFE) ; i < size; i += 2)
-    {
-      fputc(0xFF, fp);
-      fputc(0x00, fp);
-    }
-    fflush(fp);
-  }
-  fseek(fp, 0, SEEK_SET);
-
-  return 0;
-}
