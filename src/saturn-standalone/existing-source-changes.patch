+   {
+      if (i >= scspsoundlen)
+         break;
+
+      bufL[i] = new_scsp_outbuf_l[i];
+      bufR[i] = new_scsp_outbuf_r[i];
+   }
+
+   new_scsp_outbuf_pos = 0;
+}
